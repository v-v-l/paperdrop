# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paperdrop_prod

# Redis (ARQ task queue — use "redis" as host when running in Docker)
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# Telegram Local Bot API (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_API_BASE_FILE_URL=http://telegram-bot-api:8081/file/bot
TELEGRAM_LOCAL_MODE=true

# Subscription
SUBSCRIPTION_PRICE_STARS=250
FREE_TIER_LIMIT=5

# Email (Resend — Send-to-Kindle)
RESEND_API_KEY=
SENDER_EMAIL=send@paperdrop.bp-flow.com

# File processing APIs
# EPUB Fixer: runs on 192.168.100.70 (external machine)
# PDF-to-EPUB: runs on same machine (host.docker.internal from inside Docker)
EPUB_FIXER_URL=http://192.168.100.70:8010/convert
PDF_TO_EPUB_URL=http://host.docker.internal:8100/api/convert

# Application
APP_PORT=8040
BASE_URL=http://localhost:8040
MINI_APP_URL=https://paperdrop.bp-flow.com/miniapp/
TEMP_DIR=/tmp/links_to_epub
LOG_LEVEL=INFO

# Playwright
PLAYWRIGHT_ENABLED=true
